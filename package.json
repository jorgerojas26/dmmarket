{
  "name": "dmmarket",
  "version": "1.0.0",
  "private": true,
  "description": "DMMarket - Sistema de reportes de distribuci\u00f3n de alimentos (monorepo)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "backend": "bun --filter @dmmarket/backend",
    "frontend": "bun --filter @dmmarket/frontend",
    "dev:backend": "bun scripts/dev.mjs backend",
    "dev:frontend": "bun scripts/dev.mjs frontend",
    "dev": "bun scripts/dev.mjs",
    "build:frontend": "bun --filter @dmmarket/frontend build",
    "build:backend": "bun --filter @dmmarket/backend build",
    "build:windows": "bun --filter @dmmarket/backend build:windows",
    "build:linux": "bun --filter @dmmarket/backend build:linux",
    "package:installers": "bun scripts/package-installers.mjs",
    "prepare:caddy": "bun scripts/prepare-caddy.mjs",
    "test:caddy": "bun scripts/test-caddy.mjs",
    "build:installer:linux": "bun run build:linux && bun run package:installers linux",
    "build:installer:windows": "bun run build:windows && bun run package:installers windows",
    "release": "bun scripts/release.mjs",
    "test:backend": "bun scripts/test.mjs backend",
    "test:frontend": "bun scripts/test.mjs frontend",
    "test": "bun scripts/test.mjs all",
    "postinstall": "bun run scripts/dedupe-nivo.mjs",
    "check": "biome check",
    "check:write": "biome check --write",
    "check:unsafe": "biome check --write --unsafe",
    "format": "biome format --write",
    "lint": "biome lint",
    "lint:write": "biome lint --write",
    "test:integration": "bun run test:backend",
    "test:e2e": "bun run test:frontend",
    "test:prepare": "bun tests/support/prepare.cjs",
    "dev:prepare": "bun scripts/dev.mjs prepare",
    "dev:status": "bun scripts/dev.mjs status",
    "dev:doctor": "bun scripts/dev.mjs doctor",
    "dev:down": "bun scripts/dev.mjs down",
    "dev:reset": "bun scripts/dev.mjs reset",
    "test:real": "bun scripts/test.mjs real",
    "test:copy": "node scripts/test-copy.cjs"
  },
  "overrides": {
    "react-error-overlay": "6.0.9",
    "@babel/core": ">=7.22.0",
    "@nivo/arcs": "0.74.0",
    "@nivo/bar": "0.74.0",
    "@nivo/core": "0.74.0",
    "@nivo/line": "0.74.0",
    "@nivo/pie": "0.74.0",
    "@nivo/tooltip": "0.74.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@playwright/test": "1.64.1"
  }
}
