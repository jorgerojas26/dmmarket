{
  "name": "dmmarket",
  "version": "1.0.0",
  "private": true,
  "description": "DMMarket - Sistema de reportes de distribución de alimentos (monorepo)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "backend": "bun --filter @dmmarket/backend",
    "frontend": "bun --filter @dmmarket/frontend",
    "dev:backend": "bun --filter @dmmarket/backend start",
    "dev:frontend": "bun --filter @dmmarket/frontend start",
    "dev": "bun run --parallel dev:backend dev:frontend",
    "build:frontend": "bun --filter @dmmarket/frontend build",
    "build:backend": "bun --filter @dmmarket/backend build",
    "build:windows": "bun --filter @dmmarket/backend build:windows",
    "test:backend": "bun --filter @dmmarket/backend test",
    "test:frontend": "bun --filter @dmmarket/frontend test",
    "test": "bun run --parallel test:backend test:frontend",
    "check": "biome check",
    "check:write": "biome check --write",
    "check:unsafe": "biome check --write --unsafe",
    "format": "biome format --write",
    "lint": "biome lint",
    "lint:write": "biome lint --write"
  },
  "overrides": {
    "react-error-overlay": "6.0.9",
    "@babel/core": ">=7.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6"
  }
}
